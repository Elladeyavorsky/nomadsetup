---
interface Props {
    href: string;
    label: string;
    variant?: 'primary' | 'secondary'; // Could expand later
  }
  
  const { href, label } = Astro.props;
  const isExternal = href.startsWith('http');
  ---
  
  <a href={href} class="btn" target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} data-umami-event={isExternal ? "affiliate-click" : undefined} data-umami-event-url={isExternal ? href : undefined}>{label}</a>
  
  <style>
      /* Already styled globally but component wrapper is good practice */
  </style>
